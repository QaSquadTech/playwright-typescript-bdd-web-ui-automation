{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": [
      "ES2021"
    ],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "declaration": false,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "@support/*": [
        "support/*"
      ],
      "@pages/*": [
        "pages/*"
      ],
      "@config/*": [
        "config/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "**/*.ts",
    "step-definitions/**/*.ts",
    "config/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "reports",
    ".features-gen"
  ]
}